<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
    <!-- An xUnit v3 test project is an executable that runs on Microsoft Testing Platform -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- testconfig.json names the assemblies to measure. Without it, coverlet.MTP excludes the project references that it finds in deps.json. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="**\DomainResultThrowExceptionExtensionsTests.*.cs" DependentUpon="DomainResultThrowExceptionExtensionsTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\DomainResults.Common.csproj" />
    <ProjectReference Include="..\..\src\Mvc\DomainResults.Mvc.csproj" />
  </ItemGroup>

</Project>
